#!/usr/bin/env python3
"""
NewsExpress Kafka Producer
- Fetches news from NewsAPI
- Bloom Filter for duplicate detection (100K capacity, 0.1% FP rate)
- Sends unique articles to Kafka
"""

from kafka import KafkaProducer
from pybloom_live import ScalableBloomFilter
import requests
import json
import os
import time
import hashlib
import logging
from datetime import datetime

# Configure logging
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(levelname)s - %(message)s'
)
logger = logging.getLogger(__name__)

# =============================================================================
# CONFIGURATION
# =============================================================================
API_KEY = os.getenv('NEWS_API_KEY')
if not API_KEY:
    raise ValueError("NEWS_API_KEY environment variable not set")

NEWS_API_URL = f'https://newsapi.org/v2/top-headlines?country=us&apiKey={API_KEY}'
KAFKA_TOPIC = '{{ kafka_topic }}'
KAFKA_BROKER = '{{ kafka_broker }}'
POLL_INTERVAL = 600  # 10 minutes (as per requirements: 5-10 minutes)

# Bloom Filter Configuration
BLOOM_CAPACITY = 100000  # 100K articles
BLOOM_ERROR_RATE = 0.001  # 0.1% false positive rate

# =============================================================================
# BLOOM FILTER FOR DUPLICATE DETECTION
# =============================================================================
class DuplicateDetector:
    """
    Bloom Filter based duplicate detection for news articles.
    Uses article URL as unique identifier.
    """

    def __init__(self, capacity=BLOOM_CAPACITY, error_rate=BLOOM_ERROR_RATE):
        self.capacity = capacity
        self.error_rate = error_rate
        self.bloom = ScalableBloomFilter(
            initial_capacity=capacity,
            error_rate=error_rate,
            mode=ScalableBloomFilter.LARGE_SET_GROWTH
        )
        self.total_seen = 0
        self.duplicates_skipped = 0
        self.reset_count = 0
        logger.info(f"Bloom Filter initialized: capacity={capacity}, error_rate={error_rate}")

    def _get_article_id(self, article):
        """Generate unique ID from article URL or title hash"""
        url = article.get('url', '')
        if url:
            return hashlib.md5(url.encode()).hexdigest()
        # Fallback to title hash if no URL
        title = article.get('title', '')
        return hashlib.md5(title.encode()).hexdigest()

    def is_duplicate(self, article):
        """Check if article is a duplicate"""
        article_id = self._get_article_id(article)

        if article_id in self.bloom:
            self.duplicates_skipped += 1
            return True

        # Add to bloom filter
        self.bloom.add(article_id)
        self.total_seen += 1

        # Check if filter is saturated (approaching capacity)
        if self.total_seen >= self.capacity * 0.9:
            self._reset_filter()

        return False

    def _reset_filter(self):
        """Reset bloom filter when saturated"""
        self.reset_count += 1
        logger.warning(f"Bloom Filter saturated. Resetting... (Reset #{self.reset_count})")
        logger.info(f"Stats before reset: seen={self.total_seen}, duplicates={self.duplicates_skipped}")

        self.bloom = ScalableBloomFilter(
            initial_capacity=self.capacity,
            error_rate=self.error_rate,
            mode=ScalableBloomFilter.LARGE_SET_GROWTH
        )
        self.total_seen = 0
        self.duplicates_skipped = 0

    def get_stats(self):
        """Return current statistics"""
        return {
            'total_seen': self.total_seen,
            'duplicates_skipped': self.duplicates_skipped,
            'reset_count': self.reset_count,
            'capacity_used_pct': (self.total_seen / self.capacity) * 100
        }

# =============================================================================
# KAFKA PRODUCER
# =============================================================================
class NewsProducer:
    """Kafka producer with duplicate detection"""

    def __init__(self):
        self.producer = KafkaProducer(
            bootstrap_servers=KAFKA_BROKER,
            value_serializer=lambda v: json.dumps(v).encode('utf-8'),
            acks='all',  # Wait for all replicas
            retries=3,   # Retry on failure
            retry_backoff_ms=1000
        )
        self.duplicate_detector = DuplicateDetector()
        logger.info(f"Kafka Producer connected to {KAFKA_BROKER}")

    def fetch_news(self):
        """Fetch news articles from NewsAPI"""
        try:
            response = requests.get(NEWS_API_URL, timeout=30)
            if response.status_code == 200:
                data = response.json()
                articles = data.get('articles', [])
                # Filter articles with valid URLs
                valid_articles = [a for a in articles if a.get('url')]
                logger.info(f"Fetched {len(valid_articles)} valid articles from NewsAPI")
                return valid_articles
            else:
                logger.error(f"NewsAPI error: {response.status_code} - {response.text}")
                return []
        except requests.exceptions.Timeout:
            logger.error("NewsAPI request timed out")
            return []
        except Exception as e:
            logger.error(f"Exception fetching news: {e}")
            return []

    def send_article(self, article):
        """Send single article to Kafka"""
        try:
            # Add metadata
            article['_ingested_at'] = datetime.utcnow().isoformat()
            article['_source_api'] = 'newsapi'

            future = self.producer.send(KAFKA_TOPIC, article)
            # Wait for send to complete (with timeout)
            future.get(timeout=10)
            return True
        except Exception as e:
            logger.error(f"Failed to send article: {e}")
            return False

    def process_batch(self, articles):
        """Process a batch of articles with duplicate detection"""
        sent_count = 0
        duplicate_count = 0

        for article in articles:
            if self.duplicate_detector.is_duplicate(article):
                duplicate_count += 1
                continue

            if self.send_article(article):
                sent_count += 1

        return sent_count, duplicate_count

    def run(self):
        """Main producer loop"""
        logger.info("Starting NewsExpress Producer...")
        logger.info(f"Polling interval: {POLL_INTERVAL} seconds")

        while True:
            try:
                # Fetch news
                articles = self.fetch_news()

                if articles:
                    # Process with duplicate detection
                    sent, duplicates = self.process_batch(articles)

                    # Log statistics
                    stats = self.duplicate_detector.get_stats()
                    logger.info(
                        f"Batch complete: sent={sent}, duplicates_in_batch={duplicates}, "
                        f"total_duplicates={stats['duplicates_skipped']}, "
                        f"bloom_capacity_used={stats['capacity_used_pct']:.1f}%"
                    )

                # Flush to ensure all messages are sent
                self.producer.flush()

            except Exception as e:
                logger.error(f"Error in producer loop: {e}")

            # Wait for next poll
            logger.info(f"Sleeping for {POLL_INTERVAL} seconds...")
            time.sleep(POLL_INTERVAL)

    def close(self):
        """Clean shutdown"""
        self.producer.flush()
        self.producer.close()
        logger.info("Producer shut down")

# =============================================================================
# MAIN
# =============================================================================
if __name__ == '__main__':
    producer = NewsProducer()
    try:
        producer.run()
    except KeyboardInterrupt:
        logger.info("Received shutdown signal")
    finally:
        producer.close()
