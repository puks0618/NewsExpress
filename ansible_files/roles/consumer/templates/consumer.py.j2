# -----------------------------------------------------------------------------
# 1.1 RESERVOIR SAMPLING
# -----------------------------------------------------------------------------
class ReservoirSampler:
    """
    Reservoir Sampling: Maintain fixed-size random sample (1000 articles)
    Uniform probability selection using Algorithm R
    """

    def __init__(self, size: int = RESERVOIR_SIZE):
        self.size = size
        self.reservoir = []
        self.count = 0

    def add(self, item: dict) -> bool:
        """Add item to reservoir with proper probability"""
        self.count += 1

        if len(self.reservoir) < self.size:
            self.reservoir.append(item)
            return True
        else:
            # Replace with probability size/count
            j = random.randint(0, self.count - 1)
            if j < self.size:
                self.reservoir[j] = item
                return True
        return False

    def get_samples(self) -> List[dict]:
        """Return current reservoir"""
        return self.reservoir.copy()

    def get_stats(self) -> dict:
        return {
            'reservoir_size': len(self.reservoir),
            'total_seen': self.count,
            'sampling_rate': self.size / max(self.count, 1)
        }

# Global reservoir instance
