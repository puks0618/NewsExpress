# 6. BATCH PROCESSING FUNCTION
# =============================================================================

def process_batch(batch_df: DataFrame, batch_id: int):
    """
    Process each micro-batch:
    1. Parse and transform data
    2. Apply streaming algorithms
    3. Apply LSH for similarity detection
    4. Apply privacy techniques
    5. Apply sentiment analysis
    6. Write to BigQuery tables
    """

    if batch_df.count() == 0:
        print(f"Batch {batch_id}: Empty batch, skipping...")
        return

    print(f"\n{'='*60}")
    print(f"Processing Batch {batch_id} - {datetime.utcnow().isoformat()}")
    print(f"{'='*60}")

    # Convert to list of dicts for processing
    records = []
    for row in batch_df.collect():
        try:
            record = {
                'uuid': str(uuid.uuid4()),
                'source_id': row.source.id if row.source else None,
                'source_name': row.source.name if row.source else 'UNKNOWN',
                'author': row.author,
                'title': row.title,
                'description': row.description,
                'url': row.url,
                'urlToImage': row.urlToImage,
                'publishedAt': row.publishedAt,
                'content': row.content,
                'ingested_at': row._ingested_at,
                'processed_at': datetime.utcnow().isoformat()
            }
            records.append(record)
        except Exception as e:
            print(f"Error parsing record: {e}")
            continue

    if not records:
        print("No valid records to process")
        return

    print(f"Records in batch: {len(records)}")

    # -------------------------------------------------------------------------
    # STREAMING ALGORITHMS
    # -------------------------------------------------------------------------
    print("\n--- Applying Streaming Algorithms ---")

    for record in records:
        # Reservoir Sampling
        reservoir_sampler.add(record.copy())

        # Flajolet-Martin
        fm_articles.add(record['uuid'])
        fm_sources.add(record['source_name'])

        # DGIM (track article arrivals as 1s)
        dgim_articles.add(1)

        # Computing Moments
        moments_calc.add(record['source_name'])

    # Log streaming algorithm stats
    print(f"  Reservoir: {reservoir_sampler.get_stats()}")
    print(f"  FM Articles: {fm_articles.get_stats()}")
    print(f"  FM Sources: {fm_sources.get_stats()}")
    print(f"  DGIM: {dgim_articles.get_stats()}")
    print(f"  Moments: {moments_calc.get_stats()}")

    # -------------------------------------------------------------------------
    # SENTIMENT ANALYSIS
    # -------------------------------------------------------------------------
    print("\n--- Applying Sentiment Analysis ---")

    positive_count = 0
    negative_count = 0
    neutral_count = 0

    for record in records:
        sentiment_analyzer.analyze_article(record)

        if record['sentiment_label'] == 'POSITIVE':
            positive_count += 1
            dgim_positive_sentiment.add(1)
            dgim_negative_sentiment.add(0)
        elif record['sentiment_label'] == 'NEGATIVE':
            negative_count += 1
            dgim_positive_sentiment.add(0)
            dgim_negative_sentiment.add(1)
        else:
            neutral_count += 1
            dgim_positive_sentiment.add(0)
            dgim_negative_sentiment.add(0)

    print(f"  Positive: {positive_count}, Negative: {negative_count}, Neutral: {neutral_count}")

    # -------------------------------------------------------------------------
    # LSH PIPELINE
    # -------------------------------------------------------------------------
    print("\n--- Applying LSH Pipeline ---")

    import time
    lsh_start = time.time()

    for record in records:
        text = f"{record['title'] or ''} {record['description'] or ''}"
        signature = lsh_pipeline.add_document(record['uuid'], text)
        record['lsh_signature'] = signature[:10]  # Store first 10 for reference

    # Find similar pairs
    similar_pairs = lsh_pipeline.find_similar_pairs(threshold=SIMILARITY_THRESHOLD)

    lsh_time = (time.time() - lsh_start) * 1000 / max(len(records), 1)
    print(f"  LSH processing time: {lsh_time:.2f}ms per article")
    print(f"  Similar pairs found: {len(similar_pairs)}")

    # -------------------------------------------------------------------------
    # PRIVACY TECHNIQUES
    # -------------------------------------------------------------------------
    print("\n--- Applying Privacy Techniques ---")

    # K-Anonymity
    k_passing, k_suppressed = privacy_processor.apply_k_anonymity(records)
    print(f"  K-Anonymity (k={K_ANONYMITY}): {len(k_passing)} passing, {len(k_suppressed)} suppressed")

    # L-Diversity (on passing records)
    l_passing, l_suppressed = privacy_processor.check_l_diversity(k_passing)
    print(f"  L-Diversity (l={L_DIVERSITY}): {len(l_passing)} passing, {len(l_suppressed)} suppressed")

    # Differential Privacy counts
    dp_counts = privacy_processor.compute_dp_counts(records)
    print(f"  DP Counts (epsilon={EPSILON}): {len(dp_counts)} entries")

    # -------------------------------------------------------------------------
    # WRITE TO BIGQUERY
    # -------------------------------------------------------------------------
    print("\n--- Writing to BigQuery ---")

    try:
        # 1. Write main news table (with privacy applied)
        if l_passing:
            news_df = spark.createDataFrame(l_passing)
            news_df.write \
                .format("bigquery") \
                .option("table", f"{BQ_DATASET_ID}.news_table") \
                .option("temporaryGcsBucket", TEMP_BUCKET) \
                .mode("append") \
                .save()
            print(f"  news_table: {len(l_passing)} records written")

        # 2. Write similarity table
        if similar_pairs:
            sim_df = spark.createDataFrame(similar_pairs)
            sim_df.write \
                .format("bigquery") \
                .option("table", f"{BQ_DATASET_ID}.similarity_table") \
                .option("temporaryGcsBucket", TEMP_BUCKET) \
                .mode("append") \
                .save()
            print(f"  similarity_table: {len(similar_pairs)} pairs written")

        # 3. Write DP counts table
        if dp_counts:
            dp_df = spark.createDataFrame(dp_counts)
            dp_df.write \
                .format("bigquery") \
                .option("table", f"{BQ_DATASET_ID}.dp_counts_table") \
                .option("temporaryGcsBucket", TEMP_BUCKET) \
                .mode("append") \
                .save()
            print(f"  dp_counts_table: {len(dp_counts)} entries written")

        # 4. Write reservoir samples periodically
        if batch_id % 10 == 0:  # Every 10 batches
            samples = reservoir_sampler.get_samples()
            if samples:
                sample_df = spark.createDataFrame(samples)
                sample_df.write \
                    .format("bigquery") \
                    .option("table", f"{BQ_DATASET_ID}.sample_table") \
                    .option("temporaryGcsBucket", TEMP_BUCKET) \
                    .mode("overwrite") \
                    .save()
                print(f"  sample_table: {len(samples)} samples written")

        # 5. Write sentiment results
        sentiment_records = [{
            'uuid': r['uuid'],
            'title': r['title'],
            'source_name': r['source_name'],
            'sentiment_score': r['sentiment_score'],
            'sentiment_label': r['sentiment_label'],
            'subjectivity': r['subjectivity'],
            'processed_at': r['processed_at']
        } for r in records]

        if sentiment_records:
            sent_df = spark.createDataFrame(sentiment_records)
            sent_df.write \
                .format("bigquery") \
                .option("table", f"{BQ_DATASET_ID}.news_with_sentiment") \
                .option("temporaryGcsBucket", TEMP_BUCKET) \
                .mode("append") \
                .save()
            print(f"  news_with_sentiment: {len(sentiment_records)} records written")

        print(f"\nBatch {batch_id} completed successfully!")

    except Exception as e:
        print(f"Error writing to BigQuery: {e}")
        import traceback
        traceback.print_exc()


# =============================================================================
# 7. MAIN STREAMING QUERY
# =============================================================================

# Read from Kafka
raw_stream = spark.readStream \
    .format("kafka") \
    .option("kafka.bootstrap.servers", KAFKA_BROKER) \
    .option("subscribe", KAFKA_TOPIC) \
    .option("startingOffsets", "earliest") \
    .option("failOnDataLoss", "false") \
    .load()

# Parse JSON
parsed_stream = raw_stream \
    .selectExpr("CAST(value AS STRING) as json") \
    .select(from_json(col("json"), input_schema).alias("data")) \
    .select("data.*")

# Start streaming with 30-minute trigger (as per requirements)
query = parsed_stream.writeStream \
    .foreachBatch(process_batch) \
    .trigger(processingTime="30 minutes") \
    .option("checkpointLocation", f"gs://{TEMP_BUCKET}/checkpoints/newsexpress/") \
    .start()

print("\n" + "="*60)
print("NewsExpress Stream Processor Started")
print("="*60)
print(f"Kafka Broker: {KAFKA_BROKER}")
print(f"Kafka Topic: {KAFKA_TOPIC}")
print(f"BigQuery Dataset: {BQ_DATASET_ID}")
print(f"Trigger Interval: 30 minutes")
print(f"Privacy: K={K_ANONYMITY}, L={L_DIVERSITY}, Epsilon={EPSILON}")
print(f"LSH: {NUM_HASH_FUNCTIONS} hashes, {NUM_BANDS} bands, threshold={SIMILARITY_THRESHOLD}")
print("="*60 + "\n")

query.awaitTermination()
