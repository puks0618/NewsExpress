# 3. PRIVACY TECHNIQUES
# =============================================================================

class PrivacyProcessor:
    """
    Privacy Techniques:
    - K-Anonymity (k=5): Group by quasi-identifiers
    - L-Diversity (l=3): Ensure diverse sensitive values
    - Differential Privacy: Laplace mechanism (epsilon=0.5)
    """

    def __init__(self, k: int = K_ANONYMITY, l: int = L_DIVERSITY, epsilon: float = EPSILON):
        self.k = k
        self.l = l
        self.epsilon = epsilon
        self.noise_scale = 1.0 / epsilon

    # -------------------------------------------------------------------------
    # K-ANONYMITY
    # -------------------------------------------------------------------------
    def hash_author(self, author: str) -> str:
        """Hash author name using SHA-256"""
        if not author:
            return "UNKNOWN"
        salt = "newsexpress_salt_2024"
        return hashlib.sha256((salt + author).encode()).hexdigest()[:16]

    def generalize_timestamp(self, timestamp: str) -> str:
        """Generalize timestamp to date level"""
        if not timestamp:
            return "UNKNOWN_DATE"
        try:
            # Parse ISO format timestamp
            dt = datetime.fromisoformat(timestamp.replace('Z', '+00:00'))
            return dt.strftime('%Y-%m-%d')
        except:
            return timestamp[:10] if len(timestamp) >= 10 else "UNKNOWN_DATE"

    def apply_k_anonymity(self, records: List[dict]) -> Tuple[List[dict], List[dict]]:
        """
        Apply K-Anonymity:
        - Group by quasi-identifiers (source, date)
        - Suppress groups with fewer than k records
        Returns: (passing_records, suppressed_records)
        """
        # Group by quasi-identifiers
        groups = defaultdict(list)

        for record in records:
            source = record.get('source_name', 'UNKNOWN')
            date = self.generalize_timestamp(record.get('publishedAt', ''))
            group_key = (source, date)
            groups[group_key].append(record)

        passing = []
        suppressed = []

        for group_key, group_records in groups.items():
            if len(group_records) >= self.k:
                # Apply transformations to passing records
                for r in group_records:
                    r['author_hashed'] = self.hash_author(r.get('author'))
                    r['date_generalized'] = group_key[1]
                    r['k_anonymity_group_size'] = len(group_records)
                passing.extend(group_records)
            else:
                suppressed.extend(group_records)

        return passing, suppressed

    # -------------------------------------------------------------------------
    # L-DIVERSITY
    # -------------------------------------------------------------------------
    def check_l_diversity(self, records: List[dict], sensitive_attr: str = 'category') -> Tuple[List[dict], List[dict]]:
        """
        Apply L-Diversity:
        - Ensure l distinct sensitive values per group
        - Suppress groups failing validation
        Returns: (passing_records, suppressed_records)
        """
        # Group by quasi-identifiers
        groups = defaultdict(list)

        for record in records:
            source = record.get('source_name', 'UNKNOWN')
            date = record.get('date_generalized', 'UNKNOWN')
            group_key = (source, date)
            groups[group_key].append(record)

        passing = []
        suppressed = []

        for group_key, group_records in groups.items():
            # Count distinct sensitive values
            sensitive_values = set()
            for r in group_records:
                val = r.get(sensitive_attr) or r.get('source_name', 'UNKNOWN')
                sensitive_values.add(val)

            if len(sensitive_values) >= self.l:
                for r in group_records:
                    r['l_diversity_count'] = len(sensitive_values)
                passing.extend(group_records)
            else:
                suppressed.extend(group_records)

        return passing, suppressed

    # -------------------------------------------------------------------------
    # DIFFERENTIAL PRIVACY
    # -------------------------------------------------------------------------
    def laplace_noise(self, sensitivity: float = 1.0) -> float:
        """Generate Laplace noise"""
        scale = sensitivity / self.epsilon
        return np.random.laplace(0, scale)

    def add_noise_to_count(self, count: int, sensitivity: float = 1.0) -> int:
        """Add Laplace noise to count"""
        noisy_count = count + self.laplace_noise(sensitivity)
        return max(0, int(round(noisy_count)))

    def compute_dp_counts(self, records: List[dict]) -> List[dict]:
        """
        Compute differentially private counts:
        - Article counts per source
        - Topic/category frequency counts
        """
        # Count by source
        source_counts = defaultdict(int)
        topic_counts = defaultdict(int)

        for record in records:
            source = record.get('source_name', 'UNKNOWN')
            topic = record.get('category', 'general')
            source_counts[source] += 1
            topic_counts[topic] += 1

        dp_results = []
        timestamp = datetime.utcnow().isoformat()

        # Add noise to source counts
        for source, count in source_counts.items():
            noisy_count = self.add_noise_to_count(count)
            dp_results.append({
                'count_type': 'source',
                'category': source,
                'true_count': count,
                'noisy_count': noisy_count,
                'epsilon': self.epsilon,
                'timestamp': timestamp
            })

        # Add noise to topic counts
        for topic, count in topic_counts.items():
            noisy_count = self.add_noise_to_count(count)
            dp_results.append({
                'count_type': 'topic',
                'category': topic,
                'true_count': count,
                'noisy_count': noisy_count,
                'epsilon': self.epsilon,
                'timestamp': timestamp
            })

        return dp_results

