# -----------------------------------------------------------------------------
# 1.3 DGIM (Counting 1s in Sliding Window)
# -----------------------------------------------------------------------------
class DGIM:
    """
    DGIM Algorithm: Count events in sliding window
    Binary stream representation with bucket-based approximation
    """

    def __init__(self, window_size: int = 1000):
        self.window_size = window_size
        self.buckets = []  # List of (timestamp, size) tuples
        self.current_time = 0

    def add(self, bit: int):
        """Add a bit to the stream"""
        self.current_time += 1

        # Remove expired buckets
        self._remove_expired()

        if bit == 1:
            # Create new bucket of size 1
            self.buckets.append((self.current_time, 1))
            # Merge buckets if needed
            self._merge_buckets()

    def _remove_expired(self):
        """Remove buckets outside the window"""
        cutoff = self.current_time - self.window_size
        self.buckets = [(t, s) for t, s in self.buckets if t > cutoff]

    def _merge_buckets(self):
        """Merge buckets to maintain DGIM invariant (at most 2 of each size)"""
        i = len(self.buckets) - 1
        while i >= 2:
            # Check if we have 3 buckets of the same size
            if (self.buckets[i][1] == self.buckets[i-1][1] == self.buckets[i-2][1]):
                # Merge the two oldest
                new_size = self.buckets[i-2][1] * 2
                new_time = self.buckets[i-1][0]  # Keep newer timestamp
                self.buckets[i-2] = (new_time, new_size)
                del self.buckets[i-1]
                i -= 1
            else:
                i -= 1

    def count(self) -> int:
        """Estimate count of 1s in current window"""
        if not self.buckets:
            return 0

        total = 0
        for i, (_, size) in enumerate(self.buckets):
            if i == 0:
                # Oldest bucket: count half
                total += size // 2
            else:
                total += size
        return total

    def get_stats(self) -> dict:
        return {
            'estimated_count': self.count(),
            'num_buckets': len(self.buckets),
            'window_size': self.window_size,
            'current_time': self.current_time
        }

