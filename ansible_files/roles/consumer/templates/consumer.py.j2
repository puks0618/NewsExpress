# 1.4 COMPUTING MOMENTS
# -----------------------------------------------------------------------------
class MomentsCalculator:
    """
    Computing Moments: Track frequency moments of news sources
    - First moment (count): Total items
    - Second moment (surprise index): Sum of squares of frequencies
    """

    def __init__(self):
        self.frequencies = defaultdict(int)
        self.total_count = 0

    def add(self, source: str):
        """Add item and update frequencies"""
        self.frequencies[source] += 1
        self.total_count += 1

    def first_moment(self) -> int:
        """M1 = sum of frequencies = total count"""
        return self.total_count

    def second_moment(self) -> int:
        """M2 = sum of squares of frequencies (surprise index)"""
        return sum(f ** 2 for f in self.frequencies.values())

    def get_top_sources(self, n: int = 10) -> List[Tuple[str, int]]:
        """Return top N sources by frequency"""
        sorted_sources = sorted(
            self.frequencies.items(),
            key=lambda x: x[1],
            reverse=True
        )
        return sorted_sources[:n]

    def get_stats(self) -> dict:
        m1 = self.first_moment()
        m2 = self.second_moment()
        return {
            'first_moment': m1,
            'second_moment': m2,
            'unique_sources': len(self.frequencies),
            'top_sources': dict(self.get_top_sources(5))
        }

# Global moments calculator
moments_calc = MomentsCalculator()


