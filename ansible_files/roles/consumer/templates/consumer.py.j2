# 2. LSH PIPELINE
# =============================================================================

class LSHPipeline:
    """
    Complete LSH Pipeline:
    - Text Preprocessing (tokenization, lowercase, stopword removal)
    - Shingling (3-5 word n-grams)
    - MinHash (128 permutations)
    - LSH Index (5 bands)
    - Similarity detection (threshold 0.5)
    """

    STOPWORDS = {
        'the', 'a', 'an', 'and', 'or', 'but', 'in', 'on', 'at', 'to', 'for',
        'of', 'with', 'by', 'from', 'is', 'are', 'was', 'were', 'be', 'been',
        'being', 'have', 'has', 'had', 'do', 'does', 'did', 'will', 'would',
        'could', 'should', 'may', 'might', 'must', 'shall', 'can', 'this',
        'that', 'these', 'those', 'i', 'you', 'he', 'she', 'it', 'we', 'they',
        'what', 'which', 'who', 'whom', 'when', 'where', 'why', 'how', 'all',
        'each', 'every', 'both', 'few', 'more', 'most', 'other', 'some', 'such',
        'no', 'nor', 'not', 'only', 'own', 'same', 'so', 'than', 'too', 'very',
        's', 't', 'just', 'don', 'now', 'as', 'if', 'its', 'into', 'over'
    }

    def __init__(self, num_hashes: int = NUM_HASH_FUNCTIONS,
                 num_bands: int = NUM_BANDS,
                 shingle_size: int = SHINGLE_SIZE):
        self.num_hashes = num_hashes
        self.num_bands = num_bands
        self.rows_per_band = num_hashes // num_bands
        self.shingle_size = shingle_size

        # Generate hash function coefficients
        self.hash_coeffs = [
            (random.randint(1, 2**31), random.randint(0, 2**31))
            for _ in range(num_hashes)
        ]

        # LSH buckets: {band_idx: {bucket_hash: [doc_ids]}}
        self.lsh_buckets = defaultdict(lambda: defaultdict(list))

        # Store signatures for similarity computation
        self.signatures = {}

        # Store document content for debugging
        self.documents = {}

    def preprocess(self, text: str) -> List[str]:
        """
        Preprocess text:
        - Lowercase
        - Remove punctuation
        - Tokenize
        - Remove stopwords
        """
        if not text:
            return []

        # Lowercase
        text = text.lower()

        # Remove punctuation
        text = re.sub(r'[^\w\s]', '', text)

        # Tokenize
        words = text.split()

        # Remove stopwords
        words = [w for w in words if w not in self.STOPWORDS and len(w) > 1]

        return words

    def create_shingles(self, words: List[str]) -> Set[str]:
        """Create n-gram shingles from words"""
        if len(words) < self.shingle_size:
            return {' '.join(words)} if words else set()

        shingles = set()
        for i in range(len(words) - self.shingle_size + 1):
            shingle = ' '.join(words[i:i + self.shingle_size])
            shingles.add(shingle)

        return shingles

    def minhash_signature(self, shingles: Set[str]) -> List[int]:
        """Generate MinHash signature (128 hash functions)"""
        if not shingles:
            return [2**31] * self.num_hashes

        signature = [float('inf')] * self.num_hashes

        for shingle in shingles:
            shingle_hash = int(hashlib.md5(shingle.encode()).hexdigest(), 16)

            for i, (a, b) in enumerate(self.hash_coeffs):
                # Hash function: (a * x + b) mod prime
                h = (a * shingle_hash + b) % (2**31 - 1)
                signature[i] = min(signature[i], h)

        return [int(s) for s in signature]

    def add_document(self, doc_id: str, text: str) -> List[int]:
        """Process document and add to LSH index"""
        # Preprocess
        words = self.preprocess(text)

        # Create shingles
        shingles = self.create_shingles(words)

        # Generate MinHash signature
        signature = self.minhash_signature(shingles)

        # Store signature
        self.signatures[doc_id] = signature
        self.documents[doc_id] = text[:200]  # Store truncated for debugging

        # Add to LSH buckets
        for band_idx in range(self.num_bands):
            start = band_idx * self.rows_per_band
            end = start + self.rows_per_band
            band_signature = tuple(signature[start:end])
            bucket_hash = hash(band_signature)
            self.lsh_buckets[band_idx][bucket_hash].append(doc_id)

        return signature

    def find_candidates(self, doc_id: str) -> Set[str]:
        """Find candidate similar documents"""
        if doc_id not in self.signatures:
            return set()

        candidates = set()
        signature = self.signatures[doc_id]

        for band_idx in range(self.num_bands):
            start = band_idx * self.rows_per_band
            end = start + self.rows_per_band
            band_signature = tuple(signature[start:end])
            bucket_hash = hash(band_signature)

            for candidate_id in self.lsh_buckets[band_idx][bucket_hash]:
                if candidate_id != doc_id:
                    candidates.add(candidate_id)

        return candidates

    def jaccard_similarity(self, sig1: List[int], sig2: List[int]) -> float:
        """Estimate Jaccard similarity from MinHash signatures"""
        if not sig1 or not sig2:
            return 0.0
        return sum(1 for a, b in zip(sig1, sig2) if a == b) / len(sig1)

    def find_similar_pairs(self, threshold: float = SIMILARITY_THRESHOLD) -> List[dict]:
        """Find all similar document pairs above threshold"""
        similar_pairs = []
        checked_pairs = set()

        for doc_id in self.signatures:
            candidates = self.find_candidates(doc_id)

            for candidate_id in candidates:
                pair_key = tuple(sorted([doc_id, candidate_id]))
                if pair_key in checked_pairs:
                    continue
                checked_pairs.add(pair_key)

                similarity = self.jaccard_similarity(
                    self.signatures[doc_id],
                    self.signatures[candidate_id]
                )

                if similarity >= threshold:
                    similar_pairs.append({
                        'article_id_1': doc_id,
                        'article_id_2': candidate_id,
                        'jaccard_similarity': round(similarity, 4),
                        'detected_at': datetime.utcnow().isoformat()
                    })

        return similar_pairs

# Global LSH pipeline instance
lsh_pipeline = LSHPipeline()


