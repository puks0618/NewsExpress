# -----------------------------------------------------------------------------
# 1.2 FLAJOLET-MARTIN (Distinct Count Estimation)
# -----------------------------------------------------------------------------
class FlajoletMartin:
    """
    Flajolet-Martin Algorithm: Estimate distinct count using hash functions
    Uses multiple hash functions for better accuracy
    """

    def __init__(self, num_hashes: int = 10):
        self.num_hashes = num_hashes
        self.max_zeros = [0] * num_hashes
        self.actual_distinct = set()
        # Generate random seeds for hash functions
        self.seeds = [random.randint(0, 2**31) for _ in range(num_hashes)]

    def _hash(self, item: str, seed: int) -> int:
        """Hash function returning integer"""
        h = hashlib.md5((str(seed) + item).encode()).hexdigest()
        return int(h, 16)

    def _trailing_zeros(self, n: int) -> int:
        """Count trailing zeros in binary representation"""
        if n == 0:
            return 32
        count = 0
        while (n & 1) == 0:
            count += 1
            n >>= 1
        return count

    def add(self, item: str):
        """Add item and update max trailing zeros"""
        self.actual_distinct.add(item)

        for i, seed in enumerate(self.seeds):
            h = self._hash(item, seed)
            zeros = self._trailing_zeros(h)
            self.max_zeros[i] = max(self.max_zeros[i], zeros)

    def estimate_distinct(self) -> int:
        """Estimate distinct count using median of estimates"""
        estimates = [2 ** r for r in self.max_zeros]
        # Use median for robustness
        estimates.sort()
        median = estimates[len(estimates) // 2]
        return int(median * 0.77351)  # Correction factor

    def get_actual_distinct(self) -> int:
        """Return actual distinct count for comparison"""
        return len(self.actual_distinct)

    def get_stats(self) -> dict:
        estimated = self.estimate_distinct()
        actual = self.get_actual_distinct()
        error = abs(estimated - actual) / max(actual, 1) * 100
        return {
            'estimated_distinct': estimated,
            'actual_distinct': actual,
            'error_percentage': round(error, 2)
        }

